export function getTools(){return TOOLS;}
export function getToolById(id:string){return TOOLS.find((t:any)=>t&&t.id===id);}
export function getRelatedTools(id:string,cats:string[],limit=4){return TOOLS.filter((t:any)=>t&&t.id!==id&&t.categories&&t.categories.some((c:string)=>cats.includes(c))).slice(0,limit);}